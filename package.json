{
  "name": "@statelyai/graph",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "sideEffects": false,
  "version": "2.6.0",
  "description": "A TypeScript-first graph library with plain JSON-serializable objects",
  "author": "David Khourshid <david@stately.ai>",
  "license": "MIT",
  "homepage": "https://github.com/statelyai/graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statelyai/graph.git"
  },
  "bugs": {
    "url": "https://github.com/statelyai/graph/issues"
  },
  "keywords": [
    "graph",
    "directed",
    "undirected",
    "dag",
    "algorithms",
    "typescript"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./algorithms": "./dist/algorithms.mjs",
    "./format-support": "./dist/format-support.mjs",
    "./adjacency-list": "./dist/formats/adjacency-list/index.mjs",
    "./adjacency-matrix": "./dist/formats/adjacency-matrix/index.mjs",
    "./converter": "./dist/formats/converter/index.mjs",
    "./csv": "./dist/formats/csv/index.mjs",
    "./cx2": "./dist/formats/cx2/index.mjs",
    "./cytoscape": "./dist/formats/cytoscape/index.mjs",
    "./d2": "./dist/formats/d2/index.mjs",
    "./d3": "./dist/formats/d3/index.mjs",
    "./dgml": "./dist/formats/dgml/index.mjs",
    "./document": "./dist/formats/document/index.mjs",
    "./dot": "./dist/formats/dot/index.mjs",
    "./drawio": "./dist/formats/drawio/index.mjs",
    "./edge-list": "./dist/formats/edge-list/index.mjs",
    "./elk": "./dist/formats/elk/index.mjs",
    "./gexf": "./dist/formats/gexf/index.mjs",
    "./gml": "./dist/formats/gml/index.mjs",
    "./graphlib": "./dist/formats/graphlib/index.mjs",
    "./graphml": "./dist/formats/graphml/index.mjs",
    "./graphology": "./dist/formats/graphology/index.mjs",
    "./graphson": "./dist/formats/graphson/index.mjs",
    "./graphviz-json": "./dist/formats/graphviz-json/index.mjs",
    "./jgf": "./dist/formats/jgf/index.mjs",
    "./matrix-market": "./dist/formats/matrix-market/index.mjs",
    "./mermaid": "./dist/formats/mermaid/index.mjs",
    "./networkx": "./dist/formats/networkx/index.mjs",
    "./pajek": "./dist/formats/pajek/index.mjs",
    "./plantuml": "./dist/formats/plantuml/index.mjs",
    "./rdf": "./dist/formats/rdf/index.mjs",
    "./rdf/syntax": "./dist/formats/rdf/syntax.mjs",
    "./tgf": "./dist/formats/tgf/index.mjs",
    "./xyflow": "./dist/formats/xyflow/index.mjs",
    "./kernel": "./dist/kernel.mjs",
    "./layout": "./dist/layout/index.mjs",
    "./layout/cytoscape": "./dist/layout/cytoscape.mjs",
    "./layout/d3-force": "./dist/layout/d3-force.mjs",
    "./layout/d3-hierarchy": "./dist/layout/d3-hierarchy.mjs",
    "./layout/dagre": "./dist/layout/dagre.mjs",
    "./layout/elk": "./dist/layout/elk.mjs",
    "./layout/forceatlas2": "./dist/layout/forceatlas2.mjs",
    "./layout/graphviz": "./dist/layout/graphviz.mjs",
    "./layout/webcola": "./dist/layout/webcola.mjs",
    "./queries": "./dist/queries.mjs",
    "./schemas": "./dist/schemas.mjs",
    "./xstate": "./dist/xstate/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsdown",
    "bench": "vitest bench --run",
    "dev": "tsdown --watch",
    "fix:generated": "pnpm generate-schema",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:xstate-v6": "node --import tsx scripts/smoke-xstate-v6.ts",
    "typecheck:repo": "tsc --project tsconfig.repo.json",
    "check:generated": "tsx scripts/generate-json-schema.ts --check",
    "check:conventions": "tsx scripts/check-conventions.ts",
    "verify": "pnpm typecheck && pnpm typecheck:repo && pnpm check:generated && pnpm check:conventions && pnpm test -- --run && pnpm build && pnpm verify:xstate-v6 && pnpm validate:package",
    "validate:package": "publint && tsx scripts/smoke-package.ts",
    "generate-schema": "tsx scripts/generate-json-schema.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build",
    "bench:compare": "tsx bench/compare/run.ts",
    "bench:compare:quick": "tsx bench/compare/run.ts --quick",
    "bench:report": "tsx bench/compare/report.ts",
    "test:native": "vitest run --config vitest.native.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "setup:native:plantuml": "node scripts/native/setup-plantuml.mjs",
    "setup:native:graphson": "node scripts/native/setup-graphson.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dagrejs/graphlib": "^4.0.1",
    "@hpcc-js/wasm-graphviz": "^1.22.0",
    "@maxgraph/core": "0.25.0",
    "@terrastruct/d2": "0.1.33",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/jsdom": "30.0.0",
    "@types/n3": "1.26.4",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@xyflow/system": "^0.0.75",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "bumpp": "^10.3.2",
    "csv-parse": "7.0.3",
    "cytoscape": "^3.34.0",
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "dotparser": "^1.1.1",
    "elkjs": "^0.11.1",
    "fast-xml-parser": "^5.3.4",
    "fflate": "0.8.3",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-types": "^0.24.8",
    "gremlin": "3.8.2",
    "jsdom": "30.1.2",
    "mermaid": "12.1.0",
    "n3": "2.13.12",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "publint": "^0.3.15",
    "tsdown": "^0.18.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "webcola": "^3.4.0",
    "xmllint-wasm": "5.3.0",
    "xstate": "^5.28.0",
    "zod": "^4.3.6",
    "xstate-v6": "npm:xstate@6.0.0-alpha.70"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^3.0.0 || ^4.0.0",
    "@hpcc-js/wasm-graphviz": "^1.0.0",
    "cytoscape": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.0.0",
    "dotparser": "^1.0.0",
    "elkjs": "^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0",
    "fast-xml-parser": "^5.0.0",
    "fflate": "0.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.0",
    "webcola": "^3.4.0",
    "xstate": "^5.19.0 || ^6.0.0-alpha.70",
    "zod": "^4.0.0",
    "n3": "^2.13.12"
  },
